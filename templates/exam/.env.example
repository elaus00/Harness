# 복사한 .env는 커밋하지 않는다. 실제 값은 현장에서 설정한다.
HARNESS_DATABASE_PATH=data/harness.sqlite3
HARNESS_AUTH_ENABLED=false
# true이면 역할이 다른 두 계정을 JSON으로 지정한다. 비밀번호는 각 12자 이상.
HARNESS_ACCOUNTS=[]
HARNESS_WRITE_ROLES=[]
HARNESS_COOKIE_SECURE=false
HARNESS_ALLOWED_ORIGINS=["http://127.0.0.1:8080","http://localhost:8080"]
HARNESS_WORKFLOW_ENABLED=false
